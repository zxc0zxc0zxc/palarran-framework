# Global ~/.palarran/.env or project .env; explicit --env overrides selection.
# Create with memory_ops.py env-init --global or --env PATH; never commit credentials.
# Bare values only: no shell expansion, quotes, passwords or private key material for SSH.
VPS_HOST=example.invalid
VPS_USER=deploy
VPS_PORT=22
VPS_IDENTITY_FILE=
# Replace with a verified immutable CE image digest before deployment.
NEO4J_IMAGE=neo4j:2026.10.1
NEO4J_URL=http://127.0.0.1:17474
NEO4J_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
MEMORY_URL=http://127.0.0.1:18791
MEMORY_AGENT_TOKEN=REPLACE_WITH_RANDOM_AGENT_TOKEN
MEMORY_REVIEWER_TOKEN=REPLACE_WITH_DIFFERENT_REVIEWER_TOKEN
MEMORY_ARTIFACT_DIR=/var/lib/palarran-memory/artifacts

# Optional web search; global private env only. Never put the real key in Git.
KEENABLE_API_KEY=REPLACE_WITH_KEENABLE_API_KEY

# Optional Core coordination profile (distinct token per participant; project profile or ~/.palarran/.env).
# COORDINATION_URL=http://127.0.0.1:18792
# COORDINATION_TOKEN=REPLACE_WITH_PRIVATE_PARTICIPANT_TOKEN

# Optional durable execution. Project .env overrides ~/.palarran/.env.
# Only literal 0 or 1. Missing project switch inherits global; 0 explicitly disables.
# A project connection override must supply its complete independent profile.
TEMPORAL_ENABLED=0
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=palarran
# TEMPORAL_TLS=0
# Absolute owner-only file references only; never put secret values here.
# TEMPORAL_API_KEY_FILE=/ABSOLUTE/private/temporal-api-key
# TEMPORAL_TLS_CERT_FILE=/ABSOLUTE/private/client.pem
# TEMPORAL_TLS_KEY_FILE=/ABSOLUTE/private/client-key.pem
# TEMPORAL_TLS_CA_FILE=/ABSOLUTE/private/ca.pem
# Authenticated profiles require TLS=1; plaintext is loopback-only.
