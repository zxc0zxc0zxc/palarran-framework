# Global ~/.zxc0zxc0zxc/.env or project .env; explicit --env overrides selection.
# Create with memory_ops.py env-init --global or --env PATH; never commit credentials.
# Bare values only: no shell expansion, quotes, passwords or private key material for SSH.
VPS_HOST=example.invalid
VPS_USER=deploy
VPS_PORT=22
VPS_IDENTITY_FILE=
# Replace with a verified immutable CE image digest before deployment.
NEO4J_IMAGE=neo4j:2026.10.1
NEO4J_URL=http://127.0.0.1:17474
NEO4J_PASSWORD=REPLACE_WITH_RANDOM_DB_PASSWORD
MEMORY_URL=http://127.0.0.1:18791
MEMORY_AGENT_TOKEN=REPLACE_WITH_RANDOM_AGENT_TOKEN
MEMORY_REVIEWER_TOKEN=REPLACE_WITH_DIFFERENT_REVIEWER_TOKEN
MEMORY_ARTIFACT_DIR=/var/lib/ai-tools-memory/artifacts
