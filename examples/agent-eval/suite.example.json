{
  "version": 1,
  "id": "offline-contract-smoke",
  "revision": "v001",
  "candidate": "synthetic-fixture",
  "limits": {
    "run_seconds": 60,
    "task_seconds": 10,
    "lease_seconds": 3,
    "max_attempts": 1,
    "output_bytes": 65536
  },
  "policy": {
    "executables": [
      "/usr/bin/python3"
    ],
    "adapters": [
      "command"
    ],
    "env": []
  },
  "cases": [
    {
      "id": "plan",
      "category": "plan",
      "task": {
        "adapter": "command",
        "argv": [
          "/usr/bin/python3",
          "-c",
          "from pathlib import Path; Path('plan.json').write_text('{\"contract\": \"POST /items\", \"idempotency\": true, \"tests\": [\"duplicate\", \"invalid-input\"]}')"
        ]
      },
      "checks": [
        {
          "kind": "json_equals",
          "path": "plan.json",
          "expected": {
            "contract": "POST /items",
            "idempotency": true,
            "tests": [
              "duplicate",
              "invalid-input"
            ]
          }
        }
      ]
    },
    {
      "id": "review",
      "category": "review",
      "task": {
        "adapter": "command",
        "argv": [
          "/usr/bin/python3",
          "-c",
          "from pathlib import Path; Path('review.json').write_text('{\"finding\": \"untrusted-shell-input\", \"severity\": \"high\"}')"
        ]
      },
      "checks": [
        {
          "kind": "json_equals",
          "path": "review.json",
          "expected": {
            "finding": "untrusted-shell-input",
            "severity": "high"
          }
        }
      ]
    },
    {
      "id": "context",
      "category": "context",
      "task": {
        "adapter": "command",
        "argv": [
          "/usr/bin/python3",
          "-c",
          "from pathlib import Path; Path('context.json').write_text('{\"unknown_is_zero\": false}')"
        ]
      },
      "checks": [
        {
          "kind": "json_equals",
          "path": "context.json",
          "expected": {
            "unknown_is_zero": false
          }
        }
      ]
    },
    {
      "id": "build",
      "category": "build",
      "task": {
        "adapter": "command",
        "argv": [
          "/usr/bin/python3",
          "-c",
          "from pathlib import Path; Path('solution.py').write_text('def unique(items):\\n    return list(dict.fromkeys(items))\\n')"
        ]
      },
      "checks": [
        {
          "kind": "command",
          "argv": [
            "/usr/bin/python3",
            "/absolute/path/to/ai-tools/examples/agent-eval/check_build.py"
          ],
          "pins": [
            "/absolute/path/to/ai-tools/examples/agent-eval/check_build.py"
          ]
        }
      ]
    }
  ]
}
