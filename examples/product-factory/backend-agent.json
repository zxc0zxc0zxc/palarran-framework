{
  "version": 1,
  "name": "backend-agent",
  "plan_revision": "v001",
  "limits": {
    "run_seconds": 1800,
    "task_seconds": 900,
    "lease_seconds": 30,
    "max_attempts": 2,
    "output_bytes": 1048576
  },
  "policy": {
    "executables": [
      "/absolute/path/to/codex",
      "/absolute/path/to/python3"
    ],
    "adapters": [
      "codex"
    ],
    "env": [
      "PATH",
      "HOME"
    ]
  },
  "tasks": [
    {
      "id": "backend-feature",
      "adapter": "codex",
      "executable": "/absolute/path/to/codex",
      "prompt": "Read /absolute/path/to/palarran/skills/palarran-backend-build/SKILL.md and all its mandatory documentation. Target is the current worktree. Read target .palarran/INDEX.md, accepted decisions and .palarran/backend/FEATURE/plan.md revision v001. Implement only that approved SDD scope; record decisions before dependent changes and keep canonical skill progress and plan updated. Do not deploy, push or create additional autonomous runs. Missing decisions or permissions require needs_input. Follow the appended runtime handoff protocol. The verifier below must be replaced with the feature-specific DoD commands from the source plan before admission.",
      "verify": [
        [
          "/absolute/path/to/python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-v"
        ]
      ],
      "replay_safe": false,
      "model_role": "implementation",
      "model_calls": 1
    }
  ],
  "ai_policy": {
    "max_calls": 1,
    "max_units": 2,
    "max_prompt_bytes": 32768,
    "profiles": {
      "planning": {
        "model": "gpt-6.1-sol",
        "effort": "high",
        "weight": 5,
        "seconds": 600
      },
      "implementation": {
        "model": "gpt-6-luna",
        "effort": "high",
        "weight": 2,
        "seconds": 300
      },
      "simple": {
        "model": "gpt-6-luna",
        "effort": "low",
        "weight": 1,
        "seconds": 60
      }
    }
  },
  "usage_policy": {
    "max_tokens": 100000,
    "max_cost_usd": "2.00",
    "stages": {
      "backend-feature": {
        "max_tokens": 100000,
        "max_cost_usd": "2.00"
      }
    },
    "pricing": {
      "gpt-6.1-sol": {
        "input": "4",
        "cached_input": "0.2",
        "cache_creation": "5",
        "output": "15",
        "source_url": "https://developers.openai.com/api/docs/pricing",
        "as_of": "2026-10-19",
        "scope": "standard-long-context-conservative"
      },
      "gpt-6-luna": {
        "input": "0.2",
        "cached_input": "0.02",
        "cache_creation": "0.25",
        "output": "0.75",
        "source_url": "https://developers.openai.com/api/docs/pricing",
        "as_of": "2026-10-19",
        "scope": "standard-long-context-conservative"
      }
    }
  }
}
