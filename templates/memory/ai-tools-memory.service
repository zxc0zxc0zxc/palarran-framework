[Unit]
Description=Private engineering memory API
After=network.target docker.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/ai-tools-memory
ExecStart=/usr/bin/python3 -B scripts/memory_ops.py serve --env /opt/ai-tools-memory/.env
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ai-tools-memory
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
